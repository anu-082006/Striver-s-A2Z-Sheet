class Solution {    
    public int[] singleNumber(int[] nums) {        
        //your code goes here
        int x = 0;
        for(int i=0; i<nums.length; i++) {
            x = x^nums[i];
        }
        int rightMostSetBit = x & -x;
        int num1 = 0;
        int num2 = 0;
        for(int i=0; i<nums.length; i++) {
            if((nums[i] & rightMostSetBit) == 0) {
                num1 ^=nums[i];
            }
            else {
                num2 ^= nums[i];
            }
        }
        return new int[]{num1, num2};
    }
}
