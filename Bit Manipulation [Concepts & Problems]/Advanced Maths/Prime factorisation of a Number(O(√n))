class Solution {
        public List<List<Integer>> primeFactors(int[] queries) {
            //your code goes here
            List<List<Integer>> result = new ArrayList<>();
            for(int i=0; i<queries.length; i++) {
                    int n = queries[i];
                    List<Integer> factors = new ArrayList<>();
                    while(n%2==0) {
                        factors.add(2);
                        n /= 2;
                    }
                for(int j=3; j*j<=n; j+=2) {
                    while(n%j==0) {
                        factors.add(j);
                        n /= j;
                    }
                }
                if(n>1) {
                    factors.add(n);
                }
                result.add(factors);
             }
             return result;
        }
}
