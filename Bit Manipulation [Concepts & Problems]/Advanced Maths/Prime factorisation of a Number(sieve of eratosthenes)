//O(n*log(log(n)))
class Solution {
        static int MAX = 2*100000;
        static int[] spf = new int[MAX+1];//to cover max also
        static {
            spf[0] = 0;
            spf[1] = 0;
            for(int i=2; i<=MAX; i++) {
                spf[i] = i;
            }
            for(int i=2; i*i<=MAX; i++) {
                if(spf[i] == i) {
                    for(int j=i*i; j<=MAX; j+=i) {
                        if(spf[j]==j) {
                            spf[j] = i;
                        }
                    }
                }
            }
        }
        public List<List<Integer>> primeFactors(int[] queries) {
            //your code goes here
            List<List<Integer>> result = new ArrayList<>();
            for (int query : queries) {
                List<Integer> factors = new ArrayList<>();
                int n = query;
                while(n>1) {
                    factors.add(spf[n]);
                    n /= spf[n];
                }
                result.add(factors);
            }
            return result;
        }
}
