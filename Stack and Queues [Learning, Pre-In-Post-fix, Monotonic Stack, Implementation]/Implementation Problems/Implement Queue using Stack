class MyQueue {
    Stack<Integer> s1;//instead of initializing here, if in constructor - 3ms to 2ms
    Stack<Integer> s2;
    public MyQueue() {
        s1 = new Stack<>();
        s2 = new Stack<>();
    }
    
    public void push(int x) {//O(1)
        s1.push(x);
    }
    
    public int pop() {
        if(s1.isEmpty()) {
            return -1;
        }
        while(!s1.isEmpty()) {
            s2.push(s1.pop());
        }
        int pop = s2.pop();
        while(!s2.isEmpty()) {
            s1.push(s2.pop());
        }
        return pop;
    }
    
    public int peek() {
        if(s1.isEmpty()) {
            return -1;
        }
        while(!s1.isEmpty()) {
            s2.push(s1.pop());
        }
        int peek = s2.peek();
        while(!s2.isEmpty()) {
            s1.push(s2.pop());
        }
        return peek;
    }
    
    public boolean empty() {
        return s1.isEmpty();
    }
}
