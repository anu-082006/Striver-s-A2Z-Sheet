class ArrayStack {
    int[] nums;
    int top;
    public ArrayStack() {
        nums = new int[100];
        top = -1;
    }

    public void push(int x) {
       if(top == 99) {
        return;
       }
       top = top + 1;
       nums[top] = x;
    }

    public int pop() {
      if(isEmpty()) {
        return -1;
      }
      int result = nums[top];
      top = top - 1;
      return result;
    }

    public int top() {
        return nums[top];
    }

    public boolean isEmpty() {
        return top == -1;
    }
}
