class Solution {
    public int[] nextGreaterElements(int[] nums) {
        int n = nums.length;
        int[] nge = new int[n];
        Stack<Integer> s = new Stack<>();
        for(int i=(2*n)-1; i>=0; i--) {
            int idx = i%n;
            while(!s.isEmpty() && nums[s.peek()] <= nums[idx]) {
                s.pop();
            }
            if(i<n) {
                nge[i] = (s.isEmpty()) ? -1 : nums[s.peek()];
            }
            s.push(idx);
        }
        return nge;
    }
}
