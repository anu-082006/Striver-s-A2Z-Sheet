class Solution {
    public int[] nextSmallerElements(int[] arr) {
        // Your code goes here
        int n = arr.length;
        Stack<Integer> s = new Stack<>();
        int[] answer = new int[n];
        for(int i=n-1; i>=0; i--) {
            //1
            while(!s.isEmpty() && arr[s.peek()] >= arr[i]) {
                s.pop();
            }
            //2
            if(s.isEmpty()) {
                answer[i] = -1;
            }
            else {
                answer[i] = arr[s.peek()];
            }
            //3
            s.push(i);
        }
        return answer;
    }
}
