class Solution {
    public int[] unionArray(int[] nums1, int[] nums2) {
        int m = nums1.length;
        int n = nums2.length;
        int o = m+n;
        int j = 0;
        int[] union = new int[o];
        for(int i=0; i<o; i++) {
            if(i<m) {
                union[i] = nums1[i];
            }
            else {
                union[i] = nums2[j];
                j++;
            }
        }
        Arrays.sort(union);
        int count = o;
        for(int i=1; i<o; i++) {
            if(union[i] == union[i-1]) {
                count--;
            }
        }
        int[] real = new int[count];
        j=1;
        real[0] = union[0];
        for(int i=1; i<o; i++) {
            if(union[i]!=union[i-1]) {
                real[j] = union[i];
                j++;
            }
        }
        return real;
    }
}
