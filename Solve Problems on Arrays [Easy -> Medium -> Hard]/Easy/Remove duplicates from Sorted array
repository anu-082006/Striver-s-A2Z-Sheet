class Solution {
    public int removeDuplicates(int[] nums) {
        int n = nums.length;
        int j = 1;
        for(int i=1; i<n; i++) {
            if(nums[i] != nums[i-1]) {//more safer than i=0 and i != i+1
                nums[j] = nums[i];
                j++;
            }
        }
        return j;
    }
}

