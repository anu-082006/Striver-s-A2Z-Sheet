//2-pointer(1 for tracking 0 and 1 for tracking non-zero) - (O(n))
 class Solution {
    public void moveZeroes(int[] nums) {
        int n = nums.length;
        int j = 0;
        for(int i=0; i<n; i++) {
            if(nums[i]!=0 && nums[j]==0) {//swap only 0 and non-zero, prev even swapped 0 and 0
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;
            }
            if(nums[j] != 0) {//i for 0, j for non-zero
                j++;
            }
        }
    }
 }
