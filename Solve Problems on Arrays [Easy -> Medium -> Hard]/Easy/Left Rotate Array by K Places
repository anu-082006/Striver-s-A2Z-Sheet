class Solution {
    public void reverse(int[] nums, int start, int end) {
        while(start<end) {
            int temp = nums[start];
            nums[start] = nums[end];
            nums[end] = temp;
            start++;
            end--;
        }
    }
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        k=k%n;// Handle cases where k > n
        reverse(nums, 0, n-1); //reverse full array(7 6 5 4 3 2 1)
        reverse(nums, 0, k-1); //reverse 1st k elements( 5 6 7 4 3 2 1)
        reverse(nums, k, n-1);//reverse the remaining(5 6 7 1 2 3 4)
    }
}

