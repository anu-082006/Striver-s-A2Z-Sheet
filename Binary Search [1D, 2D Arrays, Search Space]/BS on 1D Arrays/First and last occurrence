class Solution {
    public int[] searchRange(int[] nums, int target) {
        int n = nums.length;
        int low = 0, high = n-1;
        int mid = 0;
        int first = -1, last = -1;
        while(low<=high) {
            mid = low + (high - low)/2;
            if(nums[mid] == target) {
                first = mid;
                high = mid-1;
            }
            else if(nums[mid] > target) {
                high = mid - 1;
            }
            else {
                low = mid + 1;
            }
        }
        low = mid+1;
        high = n-1;
        while(low<=high) {
            mid = low + (high - low)/2;
            if(nums[mid] == target) {
                low = mid + 1;
                last = mid;
            }
            else if(nums[mid] > target) {
                high = mid - 1;
            }
            else {
                low = mid + 1;
            }
        }
        if(first != -1 && last != -1) {
            return new int[]{first, last};
        }
        else if(first != -1 && last == -1) {//1 element
            return new int[]{first, first};
        }
        return new int[]{-1, -1};
    }
}
