class Solution {
    public int rowWithMax1s(int[][] mat) {
        int row = 0, col = mat[0].length-1;
        int maxRow = -1;
        while(row<mat.length && col>=0) {
            if(mat[row][col]==1) {
                maxRow = row;
                col--;
            }
            else {
                row++;
            }
        }
        return maxRow;
    }
}
