class Solution {
    public int upperBound(int row[], int num) {
        int low = 0, high = row.length;
        while(low<high) {
            int mid = (low+high)/2;
            if(row[mid] <= num) {
                low = mid + 1;
            }
            else {
                high = mid;
            }
        }
        return low;
    }
    public int findMedian(int[][] matrix) {
        int m = matrix.length;
        int n = matrix[0].length;
        int total = m*n;
        int min = Integer.MAX_VALUE;
        int max = Integer.MIN_VALUE;

        for(int i=0; i<m; i++) {
            if(matrix[i][0] < min) {
                min = matrix[i][0];
            }
            if(matrix[i][n-1] > max) {
                max = matrix[i][n-1];
            }
        }

        while(min<max) {
            int totalCount = 0;
            int mid = (min+max)/2;
            for(int i=0; i<m; i++) {
                totalCount += upperBound(matrix[i], mid);
            }
            if(totalCount <= (total/2)) {
                min = mid+1;
            }
            else {
                max = mid;
            }
        }
        return min;
    }
}
